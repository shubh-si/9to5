# Django Secret Key and Debug Mode
SECRET_KEY=django-insecure-change-this-in-production-jobportal-key-2025
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
# Set USE_POSTGRES=True to enforce PostgreSQL connection
USE_POSTGRES=False

# PostgreSQL Connection Details
DB_NAME=jobportal_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Or specify a full connection string:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/jobportal_db
